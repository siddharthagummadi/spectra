# ==============================================================================
# Spectra Enterprise Operations Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure environment-specific values.
# NEVER commit production passwords or API tokens to source control.

# --- PostgreSQL Database Configuration ---
POSTGRES_DB=spectra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# --- Spectra Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# --- Multivariate Anomaly Detection Feature Flag ---
# Default is strictly false as mandated by governance
SPECTRA_ANOMALY_DETECTION_MULTIVARIATE_ENABLED=false

# --- Spectra Python AI Microservice ---
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai-service:8001
GEMINI_API_KEY=

# --- React Frontend ---
FRONTEND_PORT=3000

# --- Prometheus Monitoring ---
PROMETHEUS_PORT=9090
